{
  "name": "@liu_zhao_feng_alex/dsh-plugin-openproject",
  "version": "1.2.0",
  "description": "OpenProject for AI agents — a DeepSeek Harness native plugin (36 Chinese-localized tools) that also ships a zero-dependency MCP server and a multi-instance CLI. Projects, work packages, time tracking, members, versions and attachments. Zero runtime dependencies.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "openproject",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "cli",
    "workbuddy",
    "project-management",
    "work-packages",
    "time-tracking",
    "agent"
  ],
  "license": "MIT",
  "author": "Zhaofeng Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koking0/dsh-plugin-openproject.git"
  },
  "homepage": "https://github.com/koking0/dsh-plugin-openproject#readme",
  "bugs": {
    "url": "https://github.com/koking0/dsh-plugin-openproject/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "openproject": "./bin/openproject.js",
    "openproject-mcp": "./bin/openproject-mcp.js"
  },
  "exports": {
    ".": "./index.js",
    "./cli": "./cli/openproject.js",
    "./mcp": "./mcp/server.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cli/",
    "mcp/",
    "bin/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "op.config.example.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "meta": {
    "title": "OpenProject 项目管理",
    "description": "通过对话管理 OpenProject：项目、工作包、工时、成员、版本与附件。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
