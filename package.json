{
  "name": "@liu_zhao_feng_alex/dsh-plugin-openproject",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin for OpenProject — manage projects, work packages, time tracking, members, versions and attachments from chat. 36 Chinese-localized tools, zero runtime dependencies.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "openproject",
    "project-management",
    "work-packages",
    "time-tracking",
    "agent"
  ],
  "license": "MIT",
  "author": "Zhaofeng Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koking0/dsh-plugin-openproject.git"
  },
  "homepage": "https://github.com/koking0/dsh-plugin-openproject#readme",
  "bugs": {
    "url": "https://github.com/koking0/dsh-plugin-openproject/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "meta": {
    "title": "OpenProject 项目管理",
    "description": "通过对话管理 OpenProject：项目、工作包、工时、成员、版本与附件。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
